#!/usr/bin/env bash
#
# Comando global de Anti-DDoS y Optimización.
# Delega en el gestor (/opt/antiddos/antiddos.sh) si está disponible
# y, en su defecto, en el instalador guardado por la propia extensión.
#
set -Eeuo pipefail

SRC_DIR="${SRC_DIR:-/opt/antiddos}"
STATE_DIR="/usr/local/share/antiddos"
MANAGER="${SRC_DIR}/antiddos.sh"
INSTALLER="${STATE_DIR}/source/scripts/addon-install.sh"

# Ejecución directa desde el repositorio clonado (./bin/antiddos ...).
LOCAL_MANAGER="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/antiddos.sh"

if [ -f "$MANAGER" ]; then
    exec bash "$MANAGER" "$@"
fi

if [ -f "$LOCAL_MANAGER" ]; then
    exec bash "$LOCAL_MANAGER" "$@"
fi

if [ -f "$INSTALLER" ]; then
    exec bash "$INSTALLER" "$@"
fi

echo "[antiddos] No se encontró el gestor en ${MANAGER} ni el instalador en ${INSTALLER}." >&2
echo "[antiddos] Reinstala con:" >&2
echo "  bash <(curl -sSL https://raw.githubusercontent.com/richi080oficial-cloud/AntiDDoS/main/install.sh) install" >&2
exit 1
